# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_voting?schema=public"

# JWT Authentication Secret & Lifespan
JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# OTP Security Settings
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=3

# SMS Provider Selection: mock | twilio | local_gateway
SMS_PROVIDER="mock"

# Twilio SMS Provider Credentials (Only needed if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Regional / Local Gateway Credentials (Only needed if SMS_PROVIDER=local_gateway)
LOCAL_SMS_API_URL="https://api.sms-gateway.iq/v1/send"
LOCAL_SMS_API_KEY="your_local_gateway_api_key"
LOCAL_SMS_SENDER_ID="IbraWaKhayt"
